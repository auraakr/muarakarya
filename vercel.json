{
    "version": 2,
    "framework": null,
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.1"
        }
    },
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "/(css|js|images|logo|mitra|element3|elementpanjang)/(.*)",
            "dest": "/public/$1/$2"
        },
        {
            "src": "/favicon.(ico|png|svg)",
            "dest": "/public/favicon.$1"
        },
        {
            "src": "/(.*)",
            "dest": "api/index.php"
        }
    ]
}